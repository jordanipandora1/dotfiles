{
  "$schema": "./config-schema.json",
  "scoop": {
    "buckets": [
      [
        "lazuee",
        "https://github.com/lazuee/scoop-bucket"
      ]
    ],
    "apps": [
      [
        "7z",
        "main/7zip",
        "regedit /s \"$(Invoke-Expression \"scoop prefix 7zip\")\\install-context.reg\""
      ],
      [
        "aria2c",
        "main/aria2",
        "scoop config aria2-warning-enabled false"
      ],
      [
        "dark",
        "main/dark"
      ],
      [
        "innounp",
        "main/innounp"
      ],
      [
        "git",
        "main/git",
        "git config --global --replace-all credential.helper manager ; git config --global --add credential.helper \"cache --timeout=3600\" ; git config --global core.autocrlf false ; git config --global core.quotepath false ; git config --global core.compression 0 ; git config --global http.postBuffer 524288000 ; git config --global http.maxRequestBuffer 524 ; git config --global i18n.logoutputencoding utf-8 ; git config --global i18n.commit.encoding utf-8 ; git config --global i18n.commitencoding utf-8 ; git config --global gui.encoding utf-8 ; git config --global --add safe.directory '*'"
      ],
      [
        "komorebi",
        "lazuee/komorebi-nightly",
        "komorebic fetch-asc"
      ],
      [
        "whkd",
        "lazuee/whkd-nightly"
      ],
      [
        "wpmd",
        "lazuee/wpm-nightly"
      ]
    ]
  },
  "winget": {
    "apps": [
      [
        "pwsh",
        "Microsoft.PowerShell"
      ],
      [
        "wt",
        "Microsoft.WindowsTerminal"
      ],
      [
        null,
        "ShareX.ShareX"
      ],
      [
        "yasbc",
        "AmN.yasb"
      ],
      [
        null,
        "NAVER.Whale"
      ],
      [
        "gh",
        "GitHub.cli"
      ],
      [
        "code",
        "Microsoft.VisualStudioCode"
      ]
    ]
  },
  "symlinks": [
    [
      ".config/komorebi/komorebi.json",
      "%USERPROFILE%/.config/komorebi/komorebi.json"
    ],
    [
      ".config/komorebi/named-workspace-rules.ps1",
      "%USERPROFILE%/.config/komorebi/named-workspace-rules.ps1"
    ],
    [
      ".config/whkd/whkdrc",
      "%USERPROFILE%/.config/whkd/whkdrc"
    ],
    [
      ".config/wpm/desktop.toml",
      "%USERPROFILE%/.config/wpm/desktop.toml"
    ],
    [
      ".config/wpm/komorebi.toml",
      "%USERPROFILE%/.config/wpm/komorebi.toml"
    ],
    [
      ".config/wpm/taskbar-toggle.toml",
      "%USERPROFILE%/.config/wpm/taskbar-toggle.toml"
    ],
    [
      ".config/wpm/whkd.toml",
      "%USERPROFILE%/.config/wpm/whkd.toml"
    ],
    [
      ".config/wpm/yasb.toml",
      "%USERPROFILE%/.config/wpm/yasb.toml"
    ],
    [
      ".config/yasb/icons",
      "%USERPROFILE%/.config/yasb/icons"
    ],
    [
      ".config/yasb/config.yaml",
      "%USERPROFILE%/.config/yasb/config.yaml"
    ],
    [
      ".config/yasb/styles.css",
      "%USERPROFILE%/.config/yasb/styles.css"
    ],
    [
      ".vscode/theme/screencast.css",
      "%USERPROFILE%/.config/vscode/screencast.css"
    ],
    [
      ".vscode/theme/styles.css",
      "%USERPROFILE%/.config/vscode/styles.css"
    ],
    [
      ".vscode/theme/script.js",
      "%USERPROFILE%/.config/vscode/script.js"
    ],
    [
      ".vscode/snippets",
      "%APPDATA%/Code/User/snippets"
    ],
    [
      ".vscode/keybindings.json",
      "%APPDATA%/Code/User/keybindings.json"
    ],
    [
      ".vscode/settings.json",
      "%APPDATA%/Code/User/settings.json"
    ]
  ]
}
